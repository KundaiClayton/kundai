---
import Layout from '../layouts/Layout.astro';
import { getAllPublished } from '../lib/content';
const posts = await getAllPublished();
---
<Layout title="Archive | Kundai Clayton">
  <main class="archive-page max-w-4xl mx-auto">
    <header class="mb-12"><p class="eyebrow mb-4">Over time</p><h1 class="section-title mb-5">The archive</h1><p class="text-subtle leading-relaxed">Every published entry, from the newest growth to the earlier seeds.</p></header>
    <div class="archive-list">
      {posts.map(post => (
        <article class="py-7 border-t border-line">
          <div class="flex flex-wrap items-center gap-4 mb-3"><span class="eyebrow">{post.contentType}</span><p class="eyebrow">{post.date}</p></div>
          <h2><a href={`/blog/${encodeURIComponent(post.slug)}`}>{post.title}</a></h2>
          <p class="text-subtle text-sm leading-relaxed mt-3 line-clamp-3">{post.description}</p>
        </article>
      ))}
    </div>
  </main>
</Layout>
<style>
  .archive-page { padding-block: var(--space-section); }
  h2 { font: 400 clamp(1.8rem, 3vw, 2.5rem)/1.15 var(--font-display); }
  h2 a:hover { color: var(--color-link); }
</style>
