---
import { getFeaturedContent } from '../lib/notion';
import BotanicalSprig from './BotanicalSprig.astro';
import StoryImage from './StoryImage.astro';
type Essay = Awaited<ReturnType<typeof getFeaturedContent>>[number];
interface Props { essays?: Essay[] }
const { essays: propEssays } = Astro.props;
let essays: Essay[] = [];
let unavailable = false;
try { essays = propEssays ?? await getFeaturedContent('Essay'); }
catch { unavailable = true; }
const [featured, ...otherEssays] = essays;
---
<section class="featured-section" aria-labelledby="featured-heading">
  <div class="featured-panel relative overflow-hidden">
    {!featured?.coverImage && <div class="feature-art" aria-hidden="true"><BotanicalSprig /></div>}
    {featured?.coverImage && <a href={`/blog/${encodeURIComponent(featured.slug)}`} tabindex="-1" aria-hidden="true" class="feature-cover"><StoryImage src={featured.coverImage} alt="" eager /></a>}
    <div class="feature-copy relative">
      <h2 id="featured-heading" class="eyebrow">Selected from the garden</h2>
      {featured ? (
        <>
          <p class="feature-kind">Featured essay</p>
          <h3><a href={`/blog/${featured.slug}`}>{featured.title}</a></h3>
          <p class="feature-description">{featured.description}</p>
          <a class="garden-link inline-flex items-center gap-6" href={`/blog/${featured.slug}`}>Read the essay <span aria-hidden="true">→</span></a>
        </>
      ) : (
        <>
          <h3>Room to grow.</h3>
          <p class="feature-description">{unavailable ? 'The essays are taking a moment to load. Try visiting the garden again shortly.' : 'A space for longer thoughts, carefully tended. New essays will appear here as they are published.'}</p>
          <a href="/garden" class="garden-link">Explore the garden →</a>
        </>
      )}
    </div>
  </div>
  {otherEssays.slice(0, 2).map(essay => (
    <a href={`/blog/${essay.slug}`} class="other-essay flex items-center justify-between gap-5">
      <div><span class="eyebrow">Also growing here</span><p>{essay.title}</p></div>
      <span class="clay-text" aria-hidden="true">↗</span>
    </a>
  ))}
</section>
<style>
  .featured-panel { border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); min-height: 25rem; box-shadow: var(--shadow-card); }
  .feature-art { position: absolute; width: 47%; height: 19rem; right: -1.5rem; top: 1.5rem; opacity: .8; }
  .feature-cover { display: block; overflow: hidden; }
  .feature-cover :global(img) { aspect-ratio: 16 / 9; object-fit: cover; }
  .featured-panel:has(.feature-cover) h3, .featured-panel:has(.feature-cover) .feature-description { max-width: 100%; }
  .featured-panel:has(.feature-cover) .feature-kind { margin-top: 1.5rem; }
  .feature-copy { padding: 2rem; }
  .feature-kind { margin-top: 3rem; color: var(--color-clay); font: .65rem var(--font-meta); text-transform: uppercase; letter-spacing: .16em; }
  h3 { position: relative; max-width: 78%; margin-block: .75rem 1.25rem; font: 400 clamp(2.5rem, 3.5vw, 3.5rem)/1.02 var(--font-display); letter-spacing: -.025em; }
  h3 a:hover { color: var(--color-clay); }
  .feature-description { position: relative; max-width: 70%; margin-bottom: 2rem; color: var(--color-muted); font-size: .9rem; line-height: 1.8; }
  .other-essay { padding-block: 1.3rem; border-bottom: 1px solid var(--color-border); }
  .other-essay p { font: 400 1.5rem/1.2 var(--font-display); margin-top: .5rem; }
  .other-essay:hover p { color: var(--color-link); }
  @media (max-width: 480px) { .feature-copy { padding: 1.5rem; } .feature-description { max-width: 80%; } .feature-art { right: -2.8rem; opacity: .5; } }
</style>
