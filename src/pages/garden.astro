---
import Layout from '../layouts/Layout.astro';
import GardenEntry from '../components/GardenEntry.astro';
import { getAllPublished } from '../lib/notion';

const entries = await getAllPublished();
const types = [...new Set(entries.map(entry => entry.contentType))].sort();
const tags = [...new Set(entries.flatMap(entry => entry.tags))].sort();
const statuses = [...new Set(entries.map(entry => entry.status))].sort();
const statusLabels: Record<string, string> = { complete: 'Tended', wip: 'Growing', draft: 'Seedling' };
const statusLabel = (status: string) => statusLabels[status] || status;
---
<Layout title="The garden | Kundai Clayton">
  <main class="garden-page" data-garden>
    <header class="mb-10">
      <p class="eyebrow mb-4">Follow a thread</p>
      <h1 class="section-title mb-5">The garden</h1>
      <p class="text-subtle leading-relaxed max-w-2xl">Essays, technical explorations and smaller thoughts. A collection that grows and changes over time.</p>
    </header>
    <form class="garden-filters flex flex-wrap items-end gap-5" aria-label="Filter the garden" action="/garden" method="get">
      <label>Kind of entry
        <select name="type"><option value="all">All entries</option>{types.map(type => <option value={type.toLowerCase()}>{type === 'Article' ? 'Articles / tech' : `${type}s`}</option>)}</select>
      </label>
      <label>Growth
        <select name="status"><option value="all">All stages</option>{statuses.map(status => <option value={status}>{statusLabel(status)}</option>)}</select>
      </label>
      <label>Topic
        <select name="tag"><option value="all">All topics</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select>
      </label>
      <button type="submit" class="garden-link filter-submit">Apply filters</button>
      <a href="/garden" data-clear-filters class="garden-link">Clear filters</a>
    </form>
    <p class="eyebrow my-7" data-result-count aria-live="polite" aria-atomic="true">{entries.length} entries</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-garden-entries>
      {entries.map(entry => (
        <div class="entry-wrapper" data-entry data-type={entry.contentType.toLowerCase()} data-status={entry.status} data-tags={JSON.stringify(entry.tags)}>
          <GardenEntry entry={entry} headingLevel="h2" />
        </div>
      ))}
    </div>
    <p class="empty-state" data-no-results hidden>No entries match these filters. <a href="/garden" data-clear-filters class="garden-link">Clear filters</a></p>
    <noscript><p class="text-subtle mt-6">All published entries are shown. Enable JavaScript to filter the collection.</p></noscript>
  </main>
</Layout>
<script>
  function setupGarden() {
    const garden = document.querySelector<HTMLElement>('[data-garden]');
    if (!garden || garden.dataset.ready) return;
    garden.dataset.ready = 'true';
    const form = garden.querySelector<HTMLFormElement>('form')!;
    const entries = [...garden.querySelectorAll<HTMLElement>('[data-entry]')];
    const controls = ['type', 'status', 'tag'].map(name => form.elements.namedItem(name) as HTMLSelectElement);
    function filterFromUrl() {
      const params = new URLSearchParams(location.search);
      controls.forEach(control => {
        const value = params.get(control.name) || 'all';
        control.value = [...control.options].some(option => option.value === value) ? value : 'all';
      });
      const [type, status, tag] = controls.map(control => control.value);
      let count = 0;
      entries.forEach(entry => {
        const matches = (type === 'all' || entry.dataset.type === type)
          && (status === 'all' || entry.dataset.status === status)
          && (tag === 'all' || JSON.parse(entry.dataset.tags || '[]').includes(tag));
        entry.hidden = !matches;
        if (matches) count++;
      });
      garden.querySelector('[data-result-count]')!.textContent = `${count} ${count === 1 ? 'entry' : 'entries'}`;
      garden.querySelector<HTMLElement>('[data-no-results]')!.hidden = count > 0;
    }
    function updateUrl() {
      const params = new URLSearchParams();
      controls.forEach(control => params.set(control.name, control.value));
      history.pushState(null, '', `/garden?${params}`);
      filterFromUrl();
    }
    form.addEventListener('change', updateUrl);
    form.addEventListener('submit', event => { event.preventDefault(); updateUrl(); });
    garden.querySelectorAll('[data-clear-filters]').forEach(link => link.addEventListener('click', event => {
      event.preventDefault(); history.pushState(null, '', '/garden'); filterFromUrl();
    }));
    garden.addEventListener('garden:filter', filterFromUrl);
    filterFromUrl();
  }
  document.addEventListener('astro:page-load', setupGarden);
  window.addEventListener('popstate', () => {
    const garden = document.querySelector<HTMLElement>('[data-garden]');
    garden?.dispatchEvent(new Event('garden:filter'));
  });
  setupGarden();
</script>
<style>
  .garden-page { padding-block: var(--space-section); }
  .garden-filters { border-block: 1px solid var(--color-border); padding-block: 1.5rem; }
  label { display: flex; flex-direction: column; gap: .65rem; color: var(--color-muted); font: .65rem var(--font-meta); }
  select { max-width: 100%; min-width: 10rem; padding: .75rem 2rem .75rem .75rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font: .8rem var(--font-body); }
  .filter-submit { padding-block: .75rem; }
  .entry-wrapper:not([hidden]) { display: flex; }
  .entry-wrapper :global(.garden-entry) { width: 100%; }
  @media (max-width: 480px) { label { width: 100%; } }
</style>
