---
import { getRecentContent } from '../lib/content';
import GardenEntry from './GardenEntry.astro';
type Note = Awaited<ReturnType<typeof getRecentContent>>[number];
interface Props { notes?: Note[] }
const { notes: propNotes } = Astro.props;
let notes: Note[] = [];
let unavailable = false;
try { notes = propNotes ?? await getRecentContent('Note', 3); }
catch { unavailable = true; }
---
<section class="recent-section" aria-labelledby="recent-heading">
  <div class="flex flex-wrap items-end justify-between gap-6 mb-8">
    <div><p class="eyebrow mb-3">Fresh growth</p><h2 id="recent-heading" class="section-title">Notes from the garden</h2></div>
    <a href="/garden" class="garden-link">All entries <span aria-hidden="true">↗</span></a>
  </div>
  {notes.length ? (
    <div class="grid md:grid-cols-3 gap-5">
      {notes.map(note => <GardenEntry entry={note} />)}
      {notes.length === 1 && (
        <aside class="garden-aside md:col-span-2 flex flex-col justify-center">
          <p class="eyebrow mb-4">Between the entries</p>
          <p class="aside-title">A practice, rather<br />than a finished thing.</p>
          <p class="aside-copy">Follow the threads, stay with a question, or see what I’m working on at the moment.</p>
          <a class="garden-link" href="/now">What I’m doing now <span aria-hidden="true">→</span></a>
        </aside>
      )}
    </div>
  ) : (
    <p class="empty-state">{unavailable ? 'The notes are temporarily unavailable. Please check back shortly.' : 'New notes will appear here as they are published. There is room to grow.'}</p>
  )}
</section>
<style>
  .recent-section { padding-block: var(--space-section); }
  .garden-aside { padding: 2rem clamp(1rem, 5vw, 5rem); }
  .aside-title { font: 400 clamp(2rem, 3.2vw, 3rem)/1.1 var(--font-display); }
  .aside-copy { color: var(--color-muted); font-size: .9rem; line-height: 1.8; max-width: 26rem; margin-block: 1rem 1.5rem; }
</style>
